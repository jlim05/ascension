# Origin of the deployed backend, no trailing /api and no trailing slash.
# Leave this unset for local development — Vite proxies /api and /hubs to
# http://localhost:5202 instead (see vite.config.ts).
#
# Set this in the Vercel project's environment variables to the Render URL:
VITE_API_URL=https://ascension-api.onrender.com
